{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-skills.json",
  "title": "AgentSkillsAppContract",
  "description": "比格熊数字导演工作站的 Agent Skills 应用合同（应用 IPC/存储/诊断），不是行业标准。作者格式遵循 agentskills.io 开放规范；本文件只定义本应用如何引用、校验、激活与读取标准包。人读说明见 specDoc。",
  "schemaVersion": 1,
  "contractScope": "application-ipc",
  "notAuthorFormat": "本合同不是 SKILL 作者格式；作者包只需标准 SKILL.md（见 SPEC §11），不得把本文件字段要求为包内文件。",
  "specDoc": "docs/dev/specs/20261002-SPEC-Agent-Skills包加载与执行合同.md",
  "specSources": [
    {
      "url": "https://agentskills.io/specification",
      "verifiedOn": "2026-10-02"
    },
    {
      "url": "https://agentskills.io/client-implementation/adding-skills-support",
      "verifiedOn": "2026-10-02"
    }
  ],
  "sources": [
    "builtin",
    "user"
  ],
  "unsupportedSources": {
    "project": "当前产品不扫描工作区目录；不虚构 project 作用域。"
  },
