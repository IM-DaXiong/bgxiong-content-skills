    "lineFormat": "<lowercase sha256 hex of file bytes>  <relpath>\n",
    "sortOrder": "relpath UTF-8 bytes ascending",
    "included": "包根下全部普通文件的内容与相对路径（包装目录与 __MACOSX/ 已去除）",
