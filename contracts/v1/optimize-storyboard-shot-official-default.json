{
  "capability": "optimize.storyboard_shot",
  "directives": {
    "prose": {}
  },
  "outputSchema": {
    "optimizedPrompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "emptyPolicy": {
    "ifCurrentPromptEmpty": "draftFromContext",
    "ifContextFieldEmpty": "omitFromPrompt",
    "forbidHostFabrication": true
  }
}
