{
  "capability": "optimize.segment",
  "directives": {
    "prose": {}
  },
  "outputSchema": {
    "finalPrompt": {
      "type": "string",
      "minLength": 1
    }
  },
  "emptyPolicy": {
    "ifCurrentPromptEmpty": "draftFromContext",
    "ifContextFieldEmpty": "omitFromPrompt",
    "forbidHostFabrication": true
  }
}
