{
  "coverage": [
    "shots"
  ],
  "steps": [
    {
      "id": "shots",
      "op": "plan_shots",
      "bind": {
        "storyId": ".storyId",
        "sceneNodeId": ".sceneNodeId",
        "sourceText": ".sourceText"
      },
      "directives": {
        "prose": {
          "style": {
            "mode": "authorText",
            "text": "文戏：表情因果清楚，禁止空泛抒情。"
          }
        }
      },
      "outputSchema": {
        "shots": {
          "count": {
            "const": 6
          },
          "item": {
            "required": [
              "shotIndex",
              "content",
              "angleId",
              "shotSize",
              "cameraMove",
              "faceBeat"
            ],
            "properties": {
              "shotIndex": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "content": {
                "type": "string",
                "minLength": 40,
                "maxLength": 160
              },
              "angleId": {
                "enum": [
                  "wide",
                  "medium",
                  "closeup",
                  "low",
                  "high",
                  "pov"
                ]
              },
              "shotSize": {
                "enum": [
                  "CU",
                  "ECU"
                ]
              },
              "cameraMove": {
                "enum": [
                  "static"
                ]
              },
              "faceBeat": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        }
      }
    }
  ]
}
